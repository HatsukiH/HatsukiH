---
import { friendsConfig } from "../../config";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout id="friends" name="友情链接" class={className} style={style}>
    <div class="flex flex-col gap-1 py-1">
        {friendsConfig.map((f) => (
            <a
                href={f.url}
                target="_blank"
                rel="noopener"
                aria-label={f.name}
                class="group flex items-center gap-2.5 rounded-lg px-1.5 py-1.5 transition hover:bg-[var(--btn-plain-bg-hover)]"
            >
                {f.avatar && (
                    <img
                        src={f.avatar}
                        alt={f.name}
                        loading="lazy"
                        onerror="this.onerror=null;this.src='/images/link-avatar.svg'"
                        class="h-7 w-7 shrink-0 rounded-md object-cover"
                    />
                )}
                <div class="min-w-0">
                    <div class="truncate text-sm font-bold text-90 transition group-hover:text-[var(--primary)]">
                        {f.name}
                    </div>
                    {f.desc && <div class="truncate text-xs text-50">{f.desc}</div>}
                </div>
            </a>
        ))}
        {friendsConfig.length === 0 && (
            <div class="px-1.5 py-2 text-sm text-50">还没有友链，去 config.ts 里加几个吧。</div>
        )}
    </div>
</WidgetLayout>
