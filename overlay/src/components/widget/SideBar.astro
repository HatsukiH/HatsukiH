---
import type { MarkdownHeading } from "astro";
import BgmPlayer from "./BgmPlayer.svelte";
import Categories from "./Categories.astro";
import Friends from "./Friends.astro";
import Profile from "./Profile.astro";
import SiteStats from "./SiteStats.astro";
import Tag from "./Tags.astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky top-4">
        <SiteStats class="onload-animation" style="animation-delay: 100ms"></SiteStats>
        <WidgetLayout id="bgm" name="背景音乐" class="onload-animation" style="animation-delay: 130ms">
            <div class="pb-1 pt-1">
                <BgmPlayer client:load></BgmPlayer>
            </div>
        </WidgetLayout>
        <Friends class="onload-animation" style="animation-delay: 160ms"></Friends>
        <Categories class="onload-animation" style="animation-delay: 190ms"></Categories>
        <Tag class="onload-animation" style="animation-delay: 220ms"></Tag>
    </div>
</div>
